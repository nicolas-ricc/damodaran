# Copy to .env and fill in. Settings: src/bot/config.py (prefix BOT_).
BOT_SEC_USER_AGENT="Nombre Apellido email@example.com"
# BOT_DATA_PROVIDER=edgar-tiingo  # default; or: edgar-stooq, fmp
BOT_TIINGO_API_KEY=""           # free key at tiingo.com; needed by refresh --prices under edgar-tiingo
# BOT_STOOQ_DIR=.cache/stooq      # edgar-stooq only: CSVs from scripts/stooq_browser_fetch.mjs
BOT_FMP_API_KEY=""              # optional — only required when BOT_DATA_PROVIDER=fmp
# BOT_ASSUMPTIONS_DIR=./config/assumptions
# BOT_DB_PATH=./bot.duckdb
# BOT_REPORTS_DIR=./reports
# BOT_NOTIFIER=none               # or: email, telegram — bot portfolio forwards a non-empty alerts.md
# BOT_SMTP_HOST=smtp.example.com  # email: required
# BOT_SMTP_PORT=587               # default; 465 with BOT_SMTP_SECURITY=ssl
# BOT_SMTP_SECURITY=starttls      # default; or: ssl, none
# BOT_SMTP_USERNAME=""
# BOT_SMTP_PASSWORD=""
# BOT_SMTP_FROM=bot@example.com   # email: required
# BOT_SMTP_TO=me@example.com      # email: required; comma-separated
# BOT_TELEGRAM_BOT_TOKEN=""       # telegram: required (from @BotFather)
# BOT_TELEGRAM_CHAT_ID=""         # telegram: required
