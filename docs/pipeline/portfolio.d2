...@classes

direction: down

# Schedule
daily: "scripts/daily.sh, weekdays 09:00 (installed by scripts/install_cron.sh)\nprice rounds, then the foreign exchange (FX) refresh,\nthen bot portfolio only when both succeeded" {class: cron}  # @file scripts/daily.sh @file scripts/install_cron.sh

# External services
tws: "Interactive Brokers (IBKR) Trader Workstation (TWS)\nor the Interactive Brokers Gateway, read-only socket through ib_async\nBOT_IBKR_HOST, BOT_IBKR_PORT, BOT_IBKR_CLIENT_ID\n(architecture decision record (ADR) 0004)" {class: external}  # @symbol bot.ingest.ibkr.IbkrClient
flex: "IBKR Flex Web Service: an Activity Flex Query,\na send request, then polls until the statement is ready" {class: external}  # @symbol bot.ingest.ibkr_flex.import_corporate_actions
channels: "email or Telegram" {class: external}

# Files
preset: "config/presets/damodaran_value.yaml:\nits quality gates and trap detection gate every holding" {class: file}  # @file config/presets/damodaran_value.yaml
override_yaml: "config/assumptions/TICKER.yaml, manual overrides when valuing a holding" {class: file}  # @file config/assumptions @symbol bot.valuator.assumptions.conventional_override_path
portfolio_template: "src/bot/reporting/templates/portfolio.md.j2" {class: file}  # @file src/bot/reporting/templates/portfolio.md.j2
alerts_template: "src/bot/reporting/templates/alerts.md.j2" {class: file}  # @file src/bot/reporting/templates/alerts.md.j2

# Database
duckdb: "DuckDB (bot.duckdb)" {
  portfolio_snapshots: {class: store}  # @table portfolio_snapshots
  cash_balances: {class: store}  # @table cash_balances
  trades: {class: store}  # @table trades
  corporate_actions: {class: store}  # @table corporate_actions
  holding_marks: {class: store}  # @table holding_marks
  events_log: {class: store}  # @table events_log
  filings_log: {class: store}  # @table filings_log
  prices_daily: {class: store}  # @table prices_daily
  currencies: {class: store}  # @table currencies
}

# Outputs
portfolio_md: "reports/YYYY-MM-DD/portfolio.md" {class: output}
alerts_md: "reports/YYYY-MM-DD/alerts.md" {class: output}
message: "alert message" {class: output}

# The command
cli: "bot portfolio [--history] [--concentration]\nsync the account, mark every holding, diff two snapshots into events,\nwrite two reports, send the alerts" {  # @symbol bot.cli.portfolio
  class: step
  exits: |md
    - notifier misconfigured: exit code 2, before anything else
    - preset damodaran_value.yaml missing: exit code 2
    - TWS unreachable (connection error or timeout): exit code 1
    - alerts not sent: exit code 1
    | {class: note}
  gates: |md The gates are the preset's quality gates plus its trap detection rules. | {class: note}
}

# Section 1-3: sync
sync: "1–3. sync the account" {  # @symbol bot.portfolio.command.run_portfolio
  snapshot: "1. snapshot: every managed account's open positions\nand cash by currency\nidempotent per (snapshot_date, account):\ndelete that day's rows of the account,\nthen insert into portfolio_snapshots and cash_balances;\nother accounts' rows of the day untouched" {  # @symbol bot.portfolio.sync.sync_portfolio
    class: step
  }
  value: "market value = quantity × latest close, expressed in the position's currency\nlatest close = newest prices_daily close on or before the snapshot date,\nin its listing currency; when that differs from the position's currency:\nclose × rate_to_usd of the listing currency ÷ rate_to_usd of the position's currency,\nnearest prior rates from currencies\neither currency unknown: close used as is\nno close, close ≤ 0, or a missing or non-positive rate:\nmarket value empty (unpriced)" {  # @symbol bot.portfolio.sync.value_positions
    class: step
    adr_0005: |md Gap: ADR 0005 (store money as reported, convert at the point of calculation) is not implemented; the universe is US-only, so every close in prices_daily is in USD and no real data exercises the cross-currency branch today. | {class: gap}  # @file docs/adr/0005-currency-handling-and-valuation-currency.md
  }
  corporate_actions: "2. corporate actions, best effort\nonly when BOT_IBKR_FLEX_TOKEN and BOT_IBKR_FLEX_QUERY_ID are set\ndividend cash transactions → dividend, action_id ct:<id>\nforward and reverse splits → split; any other type kept lower-cased,\naction_id ca:<id>\ninserted de-duplicated on action_id\nany failure: a warning, the run goes on" {  # @symbol bot.ingest.ibkr_flex.import_corporate_actions
    class: step
    unverified: |md Gap: the Flex importer was written from IBKR's documentation against a synthetic fixture and is not yet verified against a real pull (issue 110). | {class: gap}  # @symbol bot.ingest.ibkr_flex
  }
  trades: "3. trades, per account\nwatermark = newest executed_at stored for the account\nall fills TWS retains are fetched;\nthose at or after the watermark are kept\ninserted de-duplicated on exec_id\ntimestamps stored as naive Coordinated Universal Time (UTC)" {  # @symbol bot.portfolio.trades.sync_trades
    class: step
  }
}

# Section 4a: marks
marks: "4a. mark every holding" {  # @symbol bot.portfolio.marks.mark_holdings
  held: "holdings = tickers whose summed quantity ≠ 0 on the snapshot date" {
    class: step
  }
  valuation: "valuation: the analyze stage with config/assumptions/TICKER.yaml when present\n→ intrinsic value per share, latest close, red narrative flags\ncannot value: all three unknown" {  # @symbol bot.valuator.analysis.analyze
    class: step
  }
  gates: "gates: screener inputs built as the screen builds them\n(companies, financials_annual, prices_daily, currencies,\ndamodaran_industry, damodaran_country)\nfailed gates = the gates that fail; a skipped rule does not count\nsector weighted average cost of capital (WACC) from the sector benchmark\nno sector benchmark row: sector WACC unknown, gates judged without it\nticker not in companies: failed gates and sector WACC unknown" {  # @symbol bot.screener.engine.load_holding_inputs
    class: step
  }
  persist: "holding_marks: one row per holding;\nthe snapshot date's rows deleted, then inserted\nunknown values stored empty" {  # @symbol bot.portfolio.marks.persist_marks
    class: step
    unknowns: |md An unknown current value never fires an event. An unknown previous red-flag set counts as empty, so standing red flags re-fire after a day without a valuation. Unknown previous gates or sector WACC fire nothing. | {class: note}
  }
}

# Section 4b: events
events: "4b. diff two snapshots into events" {  # @symbol bot.portfolio.events.compute_events @enum bot.portfolio.events.EventType
  window: "previous snapshot = newest snapshot_date before today; none on the first run\npositions summed per ticker across accounts\nderived events diff the two persisted marks, never a recomputation" {  # @symbol bot.portfolio.marks.load_marks
    class: step
  }
  position_opened: "position_opened\nquantity ≠ 0 now, absent or 0 in the previous snapshot\nfirst run: every position" {  # @symbol bot.portfolio.events.detect_position_changes
    class: decision
  }
  position_closed: "position_closed\nquantity ≠ 0 in the previous snapshot, absent or 0 now\n(an account that returns no positions closes each of its\nholdings no other account holds)" {
    class: decision
  }
  position_size_changed: "position_size_changed: held in both and\n|Δquantity ÷ |previous quantity|| > 10%\nexactly 10%: no event" {  # @const bot.portfolio.events.DEFAULT_SIZE_CHANGE_THRESHOLD
    class: decision
  }
  currency_changed: "currency_changed\nthe ticker's portfolio_snapshots currency\n(the position's currency IBKR reports: its listing currency at the broker)\ndiffers from the previous snapshot's, both known;\nheld in several accounts: any one account's currency\nnot on the first run" {  # @symbol bot.portfolio.events.detect_currency_changes
    class: decision
  }
  dividend: "dividend\na corporate_actions row of type dividend for a holding,\neffective after the previous snapshot, on or before this one\nfirst run: every action on or before this one" {  # @symbol bot.portfolio.events.detect_corporate_action_events
    class: decision
  }
  split: "split\nthe same rule for type split (first run included)" {
    class: decision
    other_actions: |md Gap: spec §8.3 also lists other corporate actions; mergers, spin-offs and the rest are stored but fire no event. | {class: gap}
  }
  new_filing: "new_filing\na filings_log row of a holding, filed on or before this snapshot,\nfiled after the previous snapshot or ingested on or after its date,\nnot reported before: (ticker, filing type, filing date)\nabsent from events_log\nfirst run: every unreported filing" {  # @symbol bot.portfolio.events.detect_new_filings
    class: decision
    no_auto_analyze: |md Gap: spec §8.3 says a new filing auto-runs bot analyze. Verified in run_portfolio and the command: nothing reacts to new_filing; mark_holdings re-values every holding each run; no analysis report is written. | {class: gap}
  }
  intrinsic_value_crossed_price: "intrinsic_value_crossed_price\n(intrinsic value − price) < 0 before and > 0 now, or > 0 before and < 0 now\nequality is not a cross\nno previous mark, or any of the four values unknown: nothing" {  # @symbol bot.portfolio.events.detect_intrinsic_value_cross
    class: decision
  }
  new_red_flag: "new_red_flag: one per narrative flag red now\nand not red in the previous mark\nno previous mark or unknown previous flags: counts as none red\nunknown flags now: nothing" {  # @symbol bot.portfolio.events.detect_new_red_flags
    class: decision
  }
  below_quality_gate: "below_quality_gate: one per gate failing now and not failing before\nfailed gates unknown on either side, or no previous mark: nothing" {  # @symbol bot.portfolio.events.detect_below_quality_gate
    class: decision
  }
  sector_recalibrated: "sector_recalibrated: |sector WACC now − sector WACC before| > 100 bps\nexactly 100 bps: no event; either unknown: nothing" {  # @symbol bot.portfolio.events.detect_sector_recalibration @const bot.portfolio.events.DEFAULT_WACC_RECALIBRATION_BPS
    class: decision
  }
  concentration: "concentration: market value ÷ total market value > 15%, exactly 15%: no event\ntotal over positions with a market value > 0\nnot a diff: fires on every run while above" {  # @symbol bot.portfolio.events.detect_concentration @const bot.portfolio.events.DEFAULT_CONCENTRATION_THRESHOLD
    class: decision
  }
  not_events: |md Not events, by design (spec §8.3): price moves and news. | {class: note}
  persist: "append every event to events_log:\nevent_type, ticker, previous and current snapshot dates, details" {  # @symbol bot.portfolio.events.persist_events
    class: step
    reruns: |md A second run on the same day diffs against the same previous snapshot, so it appends the same events again and sends them again; only new_filing is checked against events_log. | {class: note}
  }
}

# Section 5: reports
reports: "5. reports, written to reports/YYYY-MM-DD/" {
  portfolio: "portfolio.md, the full state: positions, profit and loss (P&L), concentration,\nsuggested reviews\nP&L = market value − quantity × average cost; unpriced: P&L unknown\nconcentration weight = market value ÷ total of positions with a market value > 0;\nflagged above 15%\nsuggested review: each flagged position, consider trimming\n--history: P&L per snapshot; --concentration: the breakdown list" {  # @symbol bot.portfolio.report.build_report @symbol bot.portfolio.report.render_portfolio @const bot.portfolio.events.DEFAULT_CONCENTRATION_THRESHOLD
    class: step
  }
  alerts: "alerts.md, today's events only: type, ticker, details\nalways written; an empty file when there are no events" {  # @symbol bot.portfolio.report.render_alerts
    class: step
  }
}

# Section 6: notify
notify: "6. notify: channel checked first, alerts sent after the run" {
  channel: "which channel? BOT_NOTIFIER\nnone: nothing is sent\nemail: needs BOT_SMTP_HOST, BOT_SMTP_FROM, BOT_SMTP_TO\ntelegram: needs BOT_TELEGRAM_BOT_TOKEN, BOT_TELEGRAM_CHAT_ID\na missing setting, or a password in cleartext:\nexit code 2, before the sync" {  # @symbol bot.notifier.build_notifier
    class: decision
  }
  send: "send alerts.md?\nno channel, or a blank file: not sent\nelse its text is sent; a send failure: exit code 1\na same-day re-run sends the same alerts again" {  # @symbol bot.notifier.notify_alerts
    class: decision
  }
}

# Edges
daily -> cli: "bot portfolio, after prices and FX succeeded;\nTWS not running: exit code 1, logged to .cache/daily.log"
cli -> sync.snapshot: "1. run_portfolio"
preset -> marks.gates: "quality gates and trap detection"
override_yaml -> marks.valuation: "override of the holding"

tws -> sync.snapshot: "accounts, positions, cash"
duckdb.prices_daily -> sync.value: "latest close and its currency"
duckdb.currencies -> sync.value: "rates to USD"
duckdb.prices_daily -> marks.valuation: "latest close"
duckdb.prices_daily -> marks.gates: "latest close for the gates"
duckdb.currencies -> marks.gates: "rates to USD for market cap"
sync.snapshot -> sync.value: "positions"
sync.value -> duckdb.portfolio_snapshots: "positions with market value"
sync.snapshot -> duckdb.cash_balances: "cash by currency"
flex -> sync.corporate_actions: "statement"
sync.corporate_actions -> duckdb.corporate_actions: "new actions"
tws -> sync.trades: "fills, kept at or after the watermark"
duckdb.trades -> sync.trades: "watermark"
sync.trades -> duckdb.trades: "new fills"
sync.snapshot -> sync.corporate_actions: "2."
sync.corporate_actions -> sync.trades: "3."
sync.trades -> marks: "4."

duckdb.portfolio_snapshots -> marks.held: "snapshot rows"
marks.held -> marks.valuation: "each holding"
marks.held -> marks.gates: "each holding"
marks.valuation -> marks.persist: "intrinsic value, price, red flags"
marks.gates -> marks.persist: "failed gates, sector WACC"
marks.persist -> duckdb.holding_marks: "marks of the day"

marks -> events.window: "marks persisted"
duckdb.portfolio_snapshots -> events.position_opened: "both snapshots"
duckdb.portfolio_snapshots -> events.position_closed: "both snapshots"
duckdb.portfolio_snapshots -> events.position_size_changed: "both snapshots"
duckdb.portfolio_snapshots -> events.currency_changed: "both snapshots"
duckdb.portfolio_snapshots -> events.concentration: "this snapshot"
duckdb.corporate_actions -> events.dividend: "actions in the window"
duckdb.corporate_actions -> events.split: "actions in the window"
duckdb.filings_log -> events.new_filing: "filings of holdings"
duckdb.events_log -> events.new_filing: "filings already reported"
duckdb.holding_marks -> events.intrinsic_value_crossed_price: "previous and current marks"
duckdb.holding_marks -> events.new_red_flag: "previous and current marks"
duckdb.holding_marks -> events.below_quality_gate: "previous and current marks"
duckdb.holding_marks -> events.sector_recalibrated: "previous and current marks"
events.position_opened -> events.persist: "fires"
events.position_closed -> events.persist: "fires"
events.position_size_changed -> events.persist: "fires"
events.currency_changed -> events.persist: "fires"
events.dividend -> events.persist: "fires"
events.split -> events.persist: "fires"
events.new_filing -> events.persist: "fires"
events.intrinsic_value_crossed_price -> events.persist: "fires"
events.new_red_flag -> events.persist: "fires"
events.below_quality_gate -> events.persist: "fires"
events.sector_recalibrated -> events.persist: "fires"
events.concentration -> events.persist: "fires"
events.persist -> duckdb.events_log: "new events"

events -> reports.alerts: "today's events"
duckdb.portfolio_snapshots -> reports.portfolio: "positions and history"
duckdb.cash_balances -> reports.portfolio: "cash"
portfolio_template -> reports.portfolio: "layout"
alerts_template -> reports.alerts: "layout"
reports.portfolio -> portfolio_md: "markdown file"
reports.alerts -> alerts_md: "markdown file"
alerts_md -> notify.send: "its text"
cli -> notify.channel: "first, before the sync"
notify.channel -> notify.send: "channel"
notify.send -> channels: "non-blank alerts"
channels -> message: "delivered"
