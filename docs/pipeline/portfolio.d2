...@classes

direction: down

# Schedule
daily: "scripts/daily.sh, weekdays 09:00 (installed by scripts/install_cron.sh)\nprice rounds, then the foreign exchange (FX) refresh,\nthen bot portfolio only when both succeeded" {class: cron}  # @file scripts/daily.sh @file scripts/install_cron.sh

# External services
tws: "Interactive Brokers (IBKR) Trader Workstation (TWS)\nor the Interactive Brokers Gateway, read-only socket through ib_async\nBOT_IBKR_HOST, BOT_IBKR_PORT, BOT_IBKR_CLIENT_ID (architecture decision record (ADR) 0004)" {class: external}  # @symbol bot.ingest.ibkr.IbkrClient
flex: "IBKR Flex Web Service: an Activity Flex Query,\ntwo web requests (send the request, then poll for the statement)" {class: external}  # @symbol bot.ingest.ibkr_flex.import_corporate_actions
channels: "email or Telegram" {class: external}

# Files
preset: "config/presets/damodaran_value.yaml: its quality gates and trap detection gate every holding" {class: file}  # @file config/presets/damodaran_value.yaml
override_yaml: "config/assumptions/TICKER.yaml, manual overrides when valuing a holding" {class: file}  # @file config/assumptions @symbol bot.valuator.assumptions.conventional_override_path
portfolio_template: "src/bot/reporting/templates/portfolio.md.j2" {class: file}  # @file src/bot/reporting/templates/portfolio.md.j2
alerts_template: "src/bot/reporting/templates/alerts.md.j2" {class: file}  # @file src/bot/reporting/templates/alerts.md.j2

# Database
duckdb: "DuckDB (bot.duckdb)" {
  portfolio_snapshots: {class: store}  # @table portfolio_snapshots
  cash_balances: {class: store}  # @table cash_balances
  trades: {class: store}  # @table trades
  corporate_actions: {class: store}  # @table corporate_actions
  holding_marks: {class: store}  # @table holding_marks
  events_log: {class: store}  # @table events_log
  filings_log: {class: store}  # @table filings_log
  prices_daily: {class: store}  # @table prices_daily
  currencies: {class: store}  # @table currencies
}

# Outputs
portfolio_md: "reports/YYYY-MM-DD/portfolio.md" {class: output}
alerts_md: "reports/YYYY-MM-DD/alerts.md" {class: output}
message: "alert message" {class: output}

# The command
cli: "bot portfolio [--history] [--concentration]\nsync the account, mark every holding, diff two snapshots into events,\nwrite two reports, send the alerts" {  # @symbol bot.cli.portfolio
  class: step
  exits: |md
    - notifier misconfigured: exit code 2, before anything else
    - preset `damodaran_value.yaml` missing: exit code 2
    - TWS unreachable (connection error or timeout): exit code 1
    - alerts not sent: exit code 1
    | {class: note}
  gates: |md The gates are the preset's quality gates plus its trap detection rules. | {class: note}
}

# Section 1-3: sync
sync: "1–3. sync the account" {  # @symbol bot.portfolio.command.run_portfolio
  snapshot: "1. snapshot: every managed account's open positions and cash by currency\nidempotent per (snapshot_date, account): delete that day's rows of the account,\nthen insert into portfolio_snapshots and cash_balances;\nother accounts' rows of the day untouched" {  # @symbol bot.portfolio.sync.sync_portfolio
    class: step
  }
  value: "market value = quantity × latest close\nlatest close = newest prices_daily close on or before the snapshot date\nin the position's currency; listing currency differs:\nclose × rate_to_usd(listing currency) ÷ rate_to_usd(position currency),\nnearest prior rates from currencies\nno close, close ≤ 0, or a missing or non-positive rate: market value empty (unpriced)" {  # @symbol bot.portfolio.sync.value_positions
    class: step
    adr_0005: |md Gap: ADR 0005 (store money as reported, convert at the point of calculation) is not implemented; the universe is US-only and every holding trades in USD, so no real data exercises the cross-currency branch today. | {class: gap}  # @file docs/adr/0005-currency-handling-and-valuation-currency.md
  }
  corporate_actions: "2. corporate actions, best effort\nonly when BOT_IBKR_FLEX_TOKEN and BOT_IBKR_FLEX_QUERY_ID are set\ndividend cash transactions → dividend, action_id ct:<id>\nforward and reverse splits → split; any other type kept lower-cased,\naction_id ca:<id>\ninserted de-duplicated on action_id\nany failure: a warning, the run goes on" {  # @symbol bot.ingest.ibkr_flex.import_corporate_actions
    class: step
    unverified: |md Gap: the Flex importer was written from IBKR's documentation against a synthetic fixture and is not yet verified against a real pull (issue 110). | {class: gap}  # @symbol bot.ingest.ibkr_flex
  }
  trades: "3. trades, per account\nwatermark = newest executed_at stored for the account\nonly fills newer than the watermark are fetched\ninserted de-duplicated on exec_id\ntimestamps stored as naive Coordinated Universal Time (UTC)" {  # @symbol bot.portfolio.trades.sync_trades
    class: step
  }
}

# Section 4a: marks
marks: "4a. mark every holding" {  # @symbol bot.portfolio.marks.mark_holdings
  held: "holdings = tickers whose summed quantity ≠ 0 on the snapshot date" {
    class: step
  }
  valuation: "valuation: the analyze stage with config/assumptions/TICKER.yaml when present\n→ intrinsic value per share, latest close, red narrative flags\ncannot value: all three unknown" {  # @symbol bot.valuator.analysis.analyze
    class: step
  }
  gates: "gates: screener inputs built as the screen builds them\n(companies, financials_annual, prices_daily, damodaran_industry)\nfailed gates = the gates that fail; a skipped rule does not count\nsector weighted average cost of capital (WACC) from the sector benchmark\nticker not in companies: failed gates and sector WACC unknown" {  # @symbol bot.screener.engine.load_holding_inputs
    class: step
  }
  persist: "holding_marks: one row per holding; the snapshot date's rows deleted, then inserted\nunknown values stored empty" {
    class: step
    unknowns: |md An unknown current value never fires an event. An unknown previous red-flag set counts as empty, so standing red flags re-fire after a day without a valuation. Unknown previous gates or sector WACC fire nothing. | {class: note}
  }
}

# Edges
daily -> cli: "bot portfolio, after prices and FX succeeded; TWS not running: exit code 1, logged to .cache/daily.log"
cli -> sync.snapshot: "1. run_portfolio"
preset -> marks.gates: "quality gates and trap detection"
override_yaml -> marks.valuation: "override of the holding"

tws -> sync.snapshot: "accounts, positions, cash"
duckdb.prices_daily -> sync.value: "latest close and its currency"
duckdb.currencies -> sync.value: "rates to USD"
sync.snapshot -> sync.value: "positions"
sync.value -> duckdb.portfolio_snapshots: "positions with market value"
sync.snapshot -> duckdb.cash_balances: "cash by currency"
flex -> sync.corporate_actions: "statement"
sync.corporate_actions -> duckdb.corporate_actions: "new actions"
tws -> sync.trades: "fills newer than the watermark"
duckdb.trades -> sync.trades: "watermark"
sync.trades -> duckdb.trades: "new fills"
sync.snapshot -> sync.corporate_actions: "2."
sync.corporate_actions -> sync.trades: "3."
sync.trades -> marks: "4."

duckdb.portfolio_snapshots -> marks.held: "snapshot rows"
marks.held -> marks.valuation: "each holding"
marks.held -> marks.gates: "each holding"
marks.valuation -> marks.persist: "intrinsic value, price, red flags"
marks.gates -> marks.persist: "failed gates, sector WACC"
marks.persist -> duckdb.holding_marks: "marks of the day"
