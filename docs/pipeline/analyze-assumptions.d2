...@classes

direction: down

objective: |md Objective: give every discounted cash flow (DCF) input a value and a source, trying the sources of each assumption in order; a missing one leaves it unresolved. | {class: note}
back: |md back to the analyze board | {
  class: note
  link: "./analyze.svg"
}

# States
# @symbol bot.valuator.assumptions._load_sector_with_fallback @enum bot.valuator.assumptions.AssumptionSource
sector_read: "the sector row is read\nnewest row for the company's region, else another region's\nsector label sector_default_damodaran, or sector_default_damodaran_cross_region" {class: step}
# @symbol bot.reference.currencies.load_currency_table
currency_read: "the currency rates are read" {class: decision}
# @symbol bot.valuator.assumptions._resolve_revenue_growth
growth_set: "revenue growth is sourced" {class: decision}
# @symbol bot.valuator.assumptions._resolve_operating_margin
margin_set: "operating margin is sourced" {class: decision}
# @symbol bot.valuator.assumptions.resolve_assumptions
scalars_set: "the capital scalars are sourced" {class: decision}
# @symbol bot.valuator.assumptions._resolve_weights
weights_set: "the capital weights are sourced" {class: decision}
# @symbol bot.valuator.assumptions._resolve_terminal_growth
tg_set: "terminal growth is sourced" {class: step}
sources: |md
  The source label of each value:
  - manual: the override file
  - story_pattern: a path built for the story type
  - historical_average: the company's own history
  - sector_default_damodaran: the sector or country row of the company's region
  - sector_default_damodaran_cross_region: the sector row of another region
  - rule_based: a fixed rule or default
  - unresolved: no source, so the company cannot be valued
  | {class: note}

# Neighbours
# @symbol bot.valuator.assumptions.resolve_assumptions
story_set: "the story type is settled" {class: decision; link: "./analyze-story.svg"}  # No incoming edge: the flow enters from analyze-story
# @symbol bot.valuator.analysis.analyze
cannot_value: "the ticker cannot be valued (exit code 1)" {class: step; link: "./analyze-dcf.svg"}  # No outgoing edge: the run of this ticker ends here
# @symbol bot.valuator.analysis.analyze
ready: "tax and bankruptcy odds are set" {class: decision; link: "./analyze-dcf.svg"}  # No outgoing edge drawn: its branches are on analyze-dcf

# Stores and files
damodaran_industry: {class: store}  # @table damodaran_industry
damodaran_country: {class: store}  # @table damodaran_country
override_yaml: "config/assumptions/TICKER.yaml, manual overrides" {class: file}  # @file config/assumptions @symbol bot.valuator.assumptions.conventional_override_path
currencies_yaml: "config/currencies.yaml, risk-free rate and nominal gross domestic product (GDP) growth per currency\nabsent or malformed: empty table, every currency uncovered" {class: file}  # @file config/currencies.yaml @symbol bot.reference.currencies.load_currency_table

out: "Comes out:\nevery assumption with its value and its source label, or unresolved" {class: output; link: "./analyze-dcf.svg"}

# Edges
story_set -> sector_read: "the sector row is found [its region's, else another region's]"
story_set -> sector_read: "no sector row [industry absent from every region]"
sector_read -> currency_read: "the valuation currency is in the currency table"
sector_read -> currency_read: "the valuation currency is not in the currency table"
currency_read -> growth_set: "revenue growth gets a source [manual, story pattern, history, or nominal gross domestic product (GDP) growth]\nrevenue growth, a path over 5 years, tries in order:\n1. manual → manual\n2. high-growth with history, GDP known: straight line from the mean historical growth to nominal GDP growth → story_pattern\n3. mean historical growth, repeated → historical_average\n4. no history: nominal GDP growth each year → rule_based"  # @symbol bot.valuator.assumptions._resolve_revenue_growth @const bot.valuator.assumptions._HORIZON
currency_read -> growth_set: "revenue growth is unresolved [no history and an uncovered currency]"
growth_set -> margin_set: "operating margin gets a source [manual, story pattern, cycle average, or sector]\noperating margin, a path over 5 years, tries in order:\n1. manual → manual\n2. high-growth with a latest earnings before interest and taxes (EBIT) ÷ revenue: straight line from it to the sector margin → story_pattern\n3. cyclical with at least 4 years: mean of the yearly EBIT ÷ revenue → historical_average\n4. sector margin each year → sector label"  # @symbol bot.valuator.assumptions._resolve_operating_margin @const bot.valuator.assumptions._HORIZON @const bot.valuator.assumptions._MIN_CYCLE_YEARS
growth_set -> margin_set: "operating margin is unresolved [no sector operating margin]"
margin_set -> scalars_set: "sales-to-capital and the costs of equity and debt get a source [manual or sector]\n1. manual → manual\n2. sector value (cost of equity, pre-tax cost of debt) → sector label"
margin_set -> scalars_set: "sales-to-capital or a cost of capital is unresolved [not in the file nor the sector row]"
scalars_set -> weights_set: "the equity and debt weights get a source [manual, or the sector's debt-to-equity (D/E)]\n1. manual: one given, the other = 1 − it → manual\n2. sector D/E: debt weight = D/E ÷ (1 + D/E), equity weight = 1 − debt weight → sector label"
scalars_set -> weights_set: "the weights are unresolved [no manual weight, no sector debt-to-equity (D/E)]"
weights_set -> tg_set: "terminal growth is set by hand [in the override file]\n1. manual → manual"
weights_set -> tg_set: "terminal growth is the lower of the currency's risk-free rate and nominal gross domestic product (GDP) growth [covered currency]\n2. min(risk-free rate, nominal GDP growth) of the currency in config/currencies.yaml → rule_based"
weights_set -> tg_set: "terminal growth is unresolved [uncovered currency, not set by hand]"
scalars_set -> cannot_value: "the ticker cannot be valued, exit code 1 [both weights set by hand and not summing to 1]"
tg_set -> ready: "tax rate and bankruptcy odds are set [manual, sector, country, or 25%; bankruptcy manual or 0]\ntax rate:\n1. manual → manual\n2. sector tax_rate → sector label\n3. country tax_rate → sector_default_damodaran\n4. else 25% → rule_based\nbankruptcy odds and distress value per share: manual, else 0 → rule_based"  # @const bot.valuator.assumptions._DEFAULT_TAX_RATE @symbol bot.valuator.assumptions._resolve_tax_rate
damodaran_industry -> sector_read: "sector rows"
currencies_yaml -> currency_read: "risk-free rate and nominal GDP growth of the valuation currency"
override_yaml -> sector_read: "manual values, tried first by every assumption"
damodaran_country -> ready: "country tax rate"
tg_set -> out: "every assumption has a value and a source"
