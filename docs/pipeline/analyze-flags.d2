...@classes

direction: down

objective: |md Objective: raise five narrative flags for a human reader, and three more for a hypergrowth company; they decide nothing and enter no ranking. | {class: note}
back: |md back to the analyze board | {
  class: note
  link: "./analyze.svg"
}

# States
# @symbol bot.valuator.narrative_flags.story_margin_flag @enum bot.valuator.narrative_flags.FlagColor
story_margin_checked: "the story margin flag is set" {class: decision}
# @symbol bot.valuator.narrative_flags.growth_reinvestment_flag
reinvestment_checked: "the reinvestment flag is set" {class: decision}
# @symbol bot.valuator.narrative_flags.beta_business_risk_flag
beta_checked: "the beta flag is set" {class: decision}
# @symbol bot.valuator.narrative_flags.terminal_value_share_flag
tv_share_checked: "the terminal value share flag is set" {class: step}
# @symbol bot.valuator.narrative_flags.country_exposure_flag
country_checked: "the country flag is set" {class: decision}
# @symbol bot.valuator.narrative_flags.hypergrowth_story_flag
hg_story_checked: "the hypergrowth story flag is set" {class: decision}
# @symbol bot.valuator.narrative_flags.hypergrowth_revenue_scale_flag
scale_checked: "the revenue scale flag is set" {class: step}
# @symbol bot.valuator.narrative_flags.hypergrowth_flags
hypergrowth_checked: "the hypergrowth flags are settled" {class: step}

always_unknown: |md Gap: analyze never supplies the foreign revenue share or the two equity risk premiums, so country exposure is always unknown. | {class: gap}

only_red: |md Only growth_reinvestment can be red among the five checks: three stop at yellow and country exposure is always unknown. Among the hypergrowth flags, only hypergrowth_story can be red (signals without a story file). | {class: note}

execution_order: |md Execution order, not dependency: the margin of safety and the verdict read the value after the governance discount and the latest close; the sanity check reads the latest close, net income, diluted shares and revenue, the discounted cash flow's intrinsic value per share and enterprise value, and the sector multiples. The flags change none of them, and the sanity check does not read the verdict. | {class: note}

# Neighbours
# @symbol bot.valuator.sensitivity.scenario_range
scenarios_done: "the scenario range is settled" {class: decision; link: "./analyze-sensitivity.svg"}  # No incoming edge: the flow enters from analyze-sensitivity
# @symbol bot.valuator.analysis.analyze
discounted: "the governance discount is applied" {class: decision; link: "./analyze-verdict.svg"}  # No outgoing edge: the flow leaves through analyze-verdict

# @symbol bot.valuator.narrative_flags.narrative_flags @symbol bot.valuator.narrative_flags.hypergrowth_flags
out: "Comes out:\nfive flags, each green, yellow, red or unknown, with its reason; three more for hypergrowth" {class: output; link: "./analyze-verdict.svg"}

# Edges
scenarios_done -> story_margin_checked: "story margin is green [not high-growth, or company margin at most the sector's]"
scenarios_done -> story_margin_checked: "story margin is yellow [high-growth and company margin above the sector's]\ncompany margin = earnings before interest and taxes (EBIT) ÷ revenue, latest year"
scenarios_done -> story_margin_checked: "story margin is unknown [a margin missing]"
story_margin_checked -> reinvestment_checked: "reinvestment is red [a year with negative free cash flow, or reinvestment without profit]\nfree cash flow to the firm (FCFF) = net operating profit after tax (NOPAT) − reinvestment"
story_margin_checked -> reinvestment_checked: "reinvestment is yellow [reinvestment above 90% of after-tax operating profit]\nreinvestment ÷ NOPAT, highest over the years with NOPAT above 0"  # @const bot.valuator.narrative_flags._STRETCHED_REINVESTMENT_RATE
story_margin_checked -> reinvestment_checked: "reinvestment is green [otherwise]"
reinvestment_checked -> beta_checked: "beta is yellow [sector beta below 1.0, operating leverage above 1.5, debt above 40%]\noperating leverage = %ΔEBIT ÷ %ΔRevenue, last two years\ndebt = total debt ÷ (total debt + total equity)"  # @const bot.valuator.narrative_flags._DEFENSIVE_BETA @const bot.valuator.narrative_flags._HIGH_OPERATING_LEVERAGE @const bot.valuator.narrative_flags._HIGH_FINANCIAL_LEVERAGE
reinvestment_checked -> beta_checked: "beta is unknown [one of the three missing]"
reinvestment_checked -> beta_checked: "beta is green [otherwise]"
beta_checked -> tv_share_checked: "terminal value share is yellow [above 80% of the enterprise value]"  # @const bot.valuator.narrative_flags._TERMINAL_VALUE_SHARE_CEILING
beta_checked -> tv_share_checked: "terminal value share is green [otherwise]"
tv_share_checked -> country_checked: "country exposure is unknown [no revenue by geography is supplied]\nred would need foreign revenue share above 50% and a gap above 300 bps\ngap = weighted equity risk premium (ERP) − listing-country ERP"  # @const bot.valuator.narrative_flags._FOREIGN_REVENUE_MAJORITY @const bot.valuator.narrative_flags._ERP_GAP_THRESHOLD @symbol bot.valuator.narrative_flags.country_exposure_flag
country_checked -> hg_story_checked: "the hypergrowth story flag is set [hypergrowth signals, or the hypergrowth story type]\nhypergrowth_story is red with signals and no story file, yellow with a story file and no signals, green otherwise"  # @symbol bot.valuator.narrative_flags.hypergrowth_story_flag @symbol bot.valuator.narrative_flags.hypergrowth_flags
country_checked -> hypergrowth_checked: "no hypergrowth flag [no hypergrowth signals, and another story type]"
hg_story_checked -> scale_checked: "the revenue scale flag is set [hypergrowth story type]\nyellow when year-10 revenue is above 750B, the largest company revenue today; green otherwise"  # @const bot.valuator.narrative_flags._LARGEST_COMPANY_REVENUE @symbol bot.valuator.narrative_flags.hypergrowth_revenue_scale_flag
hg_story_checked -> hypergrowth_checked: "the scale and return flags are skipped [signals without the hypergrowth story type]"
scale_checked -> hypergrowth_checked: "the terminal return on invested capital (ROIC) flag is set\nyellow when the terminal ROIC is above 2 × the sector ROIC; green otherwise\nunknown when a ROIC is missing or the sector ROIC is 0 or below"  # @const bot.valuator.narrative_flags._ROIC_SECTOR_MULTIPLE @symbol bot.valuator.narrative_flags.hypergrowth_terminal_roic_flag
hypergrowth_checked -> discounted: "the value after the governance discount is set [the story's discount, else none]"
hypergrowth_checked -> out: "the flags go on to the report"
