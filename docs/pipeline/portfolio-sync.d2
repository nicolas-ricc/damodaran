...@classes

direction: down

objective: |md Objective: check the alert channel, then copy today's positions, cash, corporate actions and new fills from one Interactive Brokers (IBKR) Flex statement into the database. | {class: note}
back: |md back to the portfolio board | {
  class: note
  link: "./portfolio.svg"
}

# States
# @symbol bot.cli.portfolio @file config/presets/damodaran_value.yaml
started: "bot portfolio starts\npreset damodaran_value.yaml missing: exit code two, after the notifier check" {class: decision}
# @symbol bot.notifier.build_notifier
channel_misconfigured: "the run ends with exit code two before any sync" {class: step}  # No outgoing edge: the run ends here
# @symbol bot.notifier.build_notifier
channel_checked: "the notifier channel is valid" {class: decision}
# @symbol bot.cli.portfolio
credentials_missing: "the run ends with exit code two before any sync" {class: step}  # No outgoing edge: the run ends here
# @symbol bot.ingest.ibkr_flex.FlexError
statement_unavailable: "the run ends with exit code 1 before the snapshot" {class: step}  # No outgoing edge: the run ends here
# @symbol bot.ingest.ibkr_flex.FlexPortfolioClient
statement_read: "the Flex statement is read\nsnapshot date = the statement date: the newest Open Positions reportDate, else toDate\na statement older than 5 days logs a warning" {class: decision}  # @const bot.portfolio.command.STALE_AFTER_DAYS
snapshot_stored: "today's snapshot and cash are stored\nidempotent per (snapshot_date, account): that day's rows of the account are deleted, then inserted" {class: step}  # @symbol bot.portfolio.sync.sync_portfolio
# @symbol bot.ingest.ibkr_flex.upsert_corporate_actions
actions_synced: "the corporate actions of the statement are stored" {class: step}
# @symbol bot.portfolio.trades.sync_trades
trades_synced: "the new fills are stored" {class: decision}

# Neighbours
# @symbol bot.portfolio.marks.mark_holdings
holding: "it is a holding today" {class: decision; link: "./portfolio-marks.svg"}  # No outgoing edge drawn: its branches are on portfolio-marks
# @symbol bot.portfolio.events.detect_concentration
concentration_checked: "its mark events and concentration are settled" {class: decision; link: "./portfolio-mark-events.svg"}  # No outgoing edge drawn: its branches are on portfolio-mark-events

# Services and stores
flex: "IBKR Flex Web Service: one Activity Flex Query (Open Positions, Cash Report, Trades, Corporate Actions, Cash Transactions),\na send request, then polls until the statement is ready\nBOT_IBKR_FLEX_TOKEN, BOT_IBKR_FLEX_QUERY_ID, BOT_IBKR_FLEX_TZ" {class: external}  # @symbol bot.ingest.ibkr_flex.FlexPortfolioClient
prices_daily: {class: store}  # @table prices_daily
currencies: {class: store}  # @table currencies
portfolio_snapshots: {class: store}  # @table portfolio_snapshots
cash_balances: {class: store}  # @table cash_balances
corporate_actions: {class: store}  # @table corporate_actions
trades: {class: store}  # @table trades

out: "Comes out:\ntoday's snapshot rows (positions with a market value or unpriced), cash by currency, new corporate actions and new fills" {class: output; link: "./portfolio-marks.svg"}

# Edges
started -> channel_misconfigured: "the notifier check fails [a missing setting, or a password in cleartext]\nBOT_NOTIFIER email needs BOT_SMTP_HOST, BOT_SMTP_FROM, BOT_SMTP_TO; telegram needs BOT_TELEGRAM_BOT_TOKEN, BOT_TELEGRAM_CHAT_ID"
started -> channel_checked: "the notifier check passes [no channel, or every setting present]\nBOT_NOTIFIER none sends nothing; email and telegram need their settings"
channel_checked -> credentials_missing: "the run ends with exit code two before any sync [the Flex token or query id is unset]\nBOT_IBKR_FLEX_TOKEN or BOT_IBKR_FLEX_QUERY_ID is unset"
channel_checked -> statement_unavailable: "the run ends with exit code 1 before the snapshot [the Flex service refuses or fails, or the statement lacks a required section or holds a bad value]\nthe statement is downloaded once, before anything is written"
channel_checked -> statement_read: "the Flex statement is read [both credentials set, and the service returns a complete statement]"
statement_read -> snapshot_stored: "its position is stored with a market value [a close, converted when its currency differs]\nmarket value = quantity × latest close, in the position's currency; latest close = newest prices_daily close on or before the snapshot date, in its listing currency; when that differs from the position's currency: close × rate_to_usd of the listing currency ÷ rate_to_usd of the position's currency, nearest prior rates from currencies; either currency unknown: close used as is"  # @symbol bot.portfolio.sync.value_positions
statement_read -> snapshot_stored: "its position is stored unpriced [no close, a close of 0 or less, or a missing rate]\nthe market value is left empty; a rate of 0 or less counts as missing"
statement_read -> snapshot_stored: "the snapshot is stored without it [no account holds it any more]"
snapshot_stored -> actions_synced: "new corporate actions are stored from the same statement\nno separate fetch; dividend cash transactions → dividend, action_id ct:<id>; forward and reverse splits → split; any other type kept lower-cased, action_id ca:<id>; inserted de-duplicated on action_id"
actions_synced -> trades_synced: "the fills at or after the newest stored one are added\nfrom the same statement, per account: watermark = newest executed_at stored for the account; dateTime converted from BOT_IBKR_FLEX_TZ to Coordinated Universal Time (UTC); inserted de-duplicated on exec_id; stored as naive UTC"
trades_synced -> holding: "it is held today [its summed quantity is not 0]"
trades_synced -> concentration_checked: "it is neither marked nor weighed [no longer held]"
flex -> statement_read: "statement"
prices_daily -> snapshot_stored: "latest close and its currency"
currencies -> snapshot_stored: "rates to USD"
snapshot_stored -> portfolio_snapshots: "positions with market value"
snapshot_stored -> cash_balances: "cash by currency"
actions_synced -> corporate_actions: "new actions"
trades_synced -> trades: "[always: the new fills are stored]\nnew fills"
trades_synced -> out: "[always: the sync is done]"
