...@classes

direction: down

# Schedules
daily: "daily: weekdays 09:00, prices, foreign exchange rates, portfolio" {class: cron}  # @file scripts/daily.sh
weekly: "weekly: Saturdays 10:00, refresh, screen, analyze, publish" {class: cron}  # @file scripts/weekly.sh

# Stages
refresh: "refresh: download Damodaran datasets, fundamentals, end-of-day (EOD) prices and foreign exchange (FX) rates" {  # @symbol bot.cli.refresh
  class: step
}
screen: "screen: rank the universe with the quality gates and value indicators into a shortlist" {  # @symbol bot.cli.screen
  class: step
}
analyze: "analyze: value each shortlisted company and write its report" {  # @symbol bot.cli.analyze
  class: step
}
portfolio: "portfolio: sync holdings, detect events, write alerts" {  # @symbol bot.cli.portfolio
  class: step
}
site: "site: build the static viewer from the analysis sidecars" {  # @symbol bot.cli.site
  class: step
  verdicts: |md Verdict by margin of safety (MoS): 1.3 or more is potentially undervalued, 1.0 or more is around fair value, below 1.0 is potentially overvalued, n/a without a price. Viewer filters: undervalued, fair, overvalued, na. | {class: note}  # @const bot.web.views.MOS_UNDERVALUED @const bot.web.views.MOS_FAIR @enum bot.web.views.Verdict
}

# External services
damodaran_data: "Damodaran datasets (industry and country benchmarks)" {class: external}
edgar: "Securities and Exchange Commission (SEC) Electronic Data Gathering, Analysis, and Retrieval (EDGAR)" {class: external}
tiingo: "Tiingo, end-of-day (EOD) prices, default" {class: external}
stooq: "Stooq, alternative prices" {class: external}
fmp: "Financial Modeling Prep (FMP), optional: foreign exchange (FX) and non-US" {class: external}
tws: "Interactive Brokers (IBKR) Trader Workstation (TWS)" {class: external}
flex: "IBKR Flex, corporate actions" {class: external}
pages: "GitHub Pages" {class: external}

# Configuration and generated files
universe_csv: "universe tickers (CSV)" {class: file}  # @file src/bot/ingest/universe_default.csv
industry_mapping_csv: "industry mapping (CSV)" {class: file}  # @file src/bot/ingest/industry_mapping.csv
presets: "preset damodaran_value (YAML)" {class: file}  # @file config/presets/damodaran_value.yaml
assumptions: "assumption overrides per ticker (YAML)" {class: file}
sidecars: "analysis sidecars reports/YYYY-MM-DD/analysis/TICKER.json" {class: file}

# Outputs
screen_report: "screen report reports/YYYY-MM-DD/screen/preset.md and .csv" {class: output}
analysis_reports: "analysis reports TICKER.md and TICKER.html" {class: output}
portfolio_md: "portfolio.md and alerts.md" {class: output}
notifier_message: "alert message by email or Telegram" {class: output}
published_site: "published site (static viewer)" {class: output}

# Database
duckdb: "DuckDB (bot.duckdb)" {
  damodaran_industry: {class: store}  # @table damodaran_industry
  damodaran_country: {class: store}  # @table damodaran_country
  currencies: {class: store}  # @table currencies
  prices_daily: {class: store}  # @table prices_daily
  companies: {class: store}  # @table companies
  financials_annual: {class: store}  # @table financials_annual
  financials_quarterly: {class: store}  # @table financials_quarterly
  filings_log: {class: store}  # @table filings_log
  refresh_log: {class: store}  # @table refresh_log
  portfolio_snapshots: {class: store}  # @table portfolio_snapshots
  cash_balances: {class: store}  # @table cash_balances
  trades: {class: store}  # @table trades
  corporate_actions: {class: store}  # @table corporate_actions
  events_log: {class: store}  # @table events_log
  holding_marks: {class: store}  # @table holding_marks
  screener_candidates: {class: store}  # @table screener_candidates
}

# Scheduled commands, numbered in run order
weekly -> refresh: "1. bot refresh --all"
weekly -> screen: "2. bot screen --preset damodaran_value"
weekly -> analyze: "3. bot analyze --from-screen"
weekly -> site: "4. scripts/publish_site.sh"  # @file scripts/publish_site.sh
daily -> refresh: "1. bot refresh --prices, in rounds until nothing is deferred"
daily -> refresh: "2. bot refresh --fx"
daily -> portfolio: "3. bot portfolio"

# refresh: order inside is Damodaran, fundamentals, prices, foreign exchange
damodaran_data -> refresh: "industry and country datasets"
edgar -> refresh: "fundamentals and filings"
universe_csv -> refresh: "tickers to refresh"
industry_mapping_csv -> refresh: "industry mapping"
tiingo -> refresh: "end-of-day prices, default"
stooq -> refresh: "prices, alternative"
fmp -> refresh: "exchange rates and non-US data, optional"
refresh -> duckdb.damodaran_industry: "industry benchmarks"
refresh -> duckdb.damodaran_country: "country risk"
refresh -> duckdb.companies: "company profiles"
refresh -> duckdb.financials_annual: "annual statements"
refresh -> duckdb.financials_quarterly: "quarterly statements"
refresh -> duckdb.filings_log: "filing dates"
refresh -> duckdb.prices_daily: "close prices"
refresh -> duckdb.currencies: "exchange rates to USD"
refresh -> duckdb.refresh_log: "one row per source run"

# screen
presets -> screen: "gates, indicators and ranking weights"
assumptions -> screen: "overrides"
duckdb.companies -> screen: "universe"
duckdb.financials_annual -> screen: "fundamentals"
duckdb.prices_daily -> screen: "prices"
duckdb.damodaran_industry -> screen: "sector benchmark"
duckdb.damodaran_country -> screen: "country risk"
screen -> duckdb.screener_candidates: "ranked shortlist with run id"
screen -> screen_report: "shortlist report"

# analyze
duckdb.screener_candidates -> analyze: "passed candidates of the latest run, by rank"
duckdb.companies -> analyze: "company profile"
duckdb.financials_annual -> analyze: "fundamentals"
duckdb.prices_daily -> analyze: "price"
duckdb.damodaran_industry -> analyze: "sector benchmark"
duckdb.damodaran_country -> analyze: "country risk"
assumptions -> analyze: "manual overrides"
analyze -> analysis_reports: "report per company"
analyze -> sidecars: "machine-readable results"

# site
sidecars -> site: "committed to master by the publish script"
site -> published_site: "bot.web.site.build writes the viewer"  # @symbol bot.web.site.build
site -> pages: "deployed by the workflow .github/workflows/site.yml"  # @file .github/workflows/site.yml

# portfolio
tws -> portfolio: "positions, cash and executions"
flex -> portfolio: "corporate actions"
portfolio -> duckdb.portfolio_snapshots: "daily snapshot"
portfolio -> duckdb.cash_balances: "cash by currency"
portfolio -> duckdb.trades: "new executions"
portfolio -> duckdb.corporate_actions: "splits, mergers, spin-offs"
duckdb.prices_daily -> portfolio: "prices for marks"
duckdb.filings_log -> portfolio: "new filings of held companies"
duckdb.financials_annual -> portfolio: "fundamentals for quality gates and trap detection"
duckdb.holding_marks -> portfolio: "previous marks"
portfolio -> duckdb.holding_marks: "marks per snapshot"
portfolio -> duckdb.events_log: "events since last snapshot"
portfolio -> portfolio_md: "state and alerts"
portfolio -> notifier_message: "alerts sent when a notifier is configured"  # @symbol bot.notifier.notify_alerts
